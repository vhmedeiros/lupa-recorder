# Copie para agent.toml e ajuste pra esta máquina. Nunca commite o agent.toml real —
# tem segredo (hmac_secret) e é específico de cada gravador.

[agent]
name = "recorder-maringa-01"

[paths]
# HD dedicado ao acervo — vídeo/áudio bruto e miniaturas. Nunca o mesmo disco do sistema.
data_root = "/mnt/acervo/lupa-recorder"
# SSD do sistema — catálogo SQLite e scratch. Latência importa aqui, volume escrito é pequeno.
system_root = "/var/lib/lupa-recorder"

[retention]
watermark_high_system = 0.85
watermark_low_system = 0.70
watermark_high_data = 0.85
watermark_low_data = 0.70

[security]
# gere um de verdade: python -c "import secrets; print(secrets.token_urlsafe(32))"
hmac_secret = "troque-isto-por-um-segredo-real-de-pelo-menos-16-caracteres"

[http]
# Servidor HTTP local (sub-etapa 1.7) — playlist sintética, segmentos, miniaturas, probe.
# Escuta em 127.0.0.1 E no IP da tailnet (autodetectado via `tailscale ip -4`), nunca 0.0.0.0.
port = 8383
# bind_tailnet = true       # desligar só em teste local, onde não há tailnet
# tailnet_ip = "100.x.y.z"  # fixa o IP da tailnet, pulando a autodetecção
